{
  "name": "anjor-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/site.mjs preflight",
    "build": "vite build && vite build --ssr src/ssr.jsx --outDir dist-ssr && node scripts/site.mjs postbuild",
    "preview": "vite preview",
    "preview:prod": "node scripts/site.mjs serve",
    "check": "node scripts/site.mjs check",
    "links": "node scripts/site.mjs links",
    "indexnow": "node scripts/site.mjs indexnow",
    "verify": "npm run build && node scripts/site.mjs check && node scripts/site.mjs links"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=20.19"
  }
}
